{
    "name": "@rasel/ui-builder",
    "version": "0.1.0",
    "private": true,
    "description": "Declarative CRUD screens, forms, tables and themes for Vue 3 + Inertia. One package: components, framework-free helpers and styles.",
    "type": "module",
    "sideEffects": [
        "*.vue",
        "*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./i18n": "./src/i18n/index.ts",
        "./styles/*.css": "./styles/*.css",
        "./ui-builder.css": "./dist/ui-builder.css",
        "./*.vue": "./src/*.vue",
        "./*.json": "./src/*.json",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "build:css": "node scripts/build-css.mjs"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@lucide/vue": "~1.70.0",
        "@vueup/vue-quill": "~1.5.5",
        "@vueuse/core": "~12.8.2",
        "axios": "~1.21.0",
        "class-variance-authority": "~0.7.1",
        "clsx": "~2.1.1",
        "date-fns": "~4.4.0",
        "exceljs": "~4.4.0",
        "file-saver": "~2.0.5",
        "jspdf": "~4.2.1",
        "jspdf-autotable": "~5.0.9",
        "pluralize": "~8.0.0",
        "quill": "~2.0.2",
        "reka-ui": "~2.11.0",
        "sweetalert2": "~11.26.25",
        "tailwind-merge": "~3.7.0",
        "tw-animate-css": "~1.4.0",
        "vue-select": "4.0.0-beta.6"
    },
    "devDependencies": {
        "@tailwindcss/node": "^4.3.0",
        "@tailwindcss/oxide": "^4.3.0",
        "@types/pluralize": "0.0.33",
        "tailwindcss": "^4.3.0"
    }
}
